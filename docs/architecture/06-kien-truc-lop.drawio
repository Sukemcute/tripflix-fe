 value="" style="rounded=1;arcSize=5;fillColor=#ffffff;strokeColor=#b8941f;fontSize=11;verticalAlign=top;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="478" width="322" height="90" as="geometry" /></mxCell><mxCell id="n39" value="&lt;b&gt;analytics&lt;/b&gt;" style="text;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#000000;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="481" width="306" height="18" as="geometry" /></mxCell><mxCell id="n40" value="chỉ nhận sự kiện · chỉ đọc bảng của mình" style="text;align=center;verticalAlign=middle;fontSize=9;fontColor=#666666;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="546" width="314" height="18" as="geometry" /></mxCell><mxCell id="n41" value="&lt;b&gt;events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Trang · chia ngày&lt;/font&gt;" style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="502" width="98" height="40" as="geometry" /></mxCell><mxCell id="n42" value="&lt;b&gt;mart_*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Trang · 5 phút&lt;/font&gt;" style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="142" y="502" width="98" height="40" as="geometry" /></mxCell><mxCell id="n43" value="&lt;b&gt;API số liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;/analytics/*&lt;/font&gt;" style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="246" y="502" width="98" height="40" as="geometry" /></mxCell><mxCell id="n44" value="không query chéo schema, không transaction chéo module&lt;br&gt;đọc qua index.ts, phản ứng qua event + outbox&lt;br&gt;transaction mở ở use case, không giữ khi gọi ra ngoài · Idempotency-Key&lt;br&gt;jobs nền: xu hướng, hết hạn giữ chỗ, mở lịch trống đủ 180 ngày (6 giờ/lần)&lt;br&gt;analytics dùng pool kết nối riêng, không làm chậm đặt chỗ" style="text;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="482" width="540" height="86" as="geometry" /></mxCell><mxCell id="n45" value="&lt;b&gt;ai-service — tripflix-ai · Bảo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Python · FastAPI · trợ lý chat (SSE), parse-query,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;summarize, moderate, embed · không lưu dữ liệu nghiệp vụ&lt;/font&gt;" style="rounded=1;arcSize=5;fillColor=#d0f0ec;strokeColor=#00a596;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="610" width="330" height="65" as="geometry" /></mxCell><mxCell id="n46" value="REST nội bộ&lt;br&gt;(search ↔ moderate, parse)" style="text;align=left;verticalAlign=middle;fontSize=9;fontColor=#444444;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1037" y="580" width="150" height="28" as="geometry" /></mxCell><mxCell id="n47" value="ai-service ngang hàng core-api: app, web gọi thẳng qua /ai; trợ lý chỉ gợi ý chỗ, bài có thật&lt;br&gt;lấy từ API tìm kiếm của discovery · content, discovery gọi moderate, parse-query, summarize&lt;br&gt;chi phí mỗi cuộc trò chuyện phát ai.usage.recorded về module analytics" style="text;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="790" height="70" as="geometry" /></mxCell><mxCell id="n48" value="outbox → Redis Streams · ai-service → OpenAI" style="text;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#333333;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="692" width="580" height="26" as="geometry" /></mxCell><mxCell id="n49" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1180" height="140" as="geometry" /></mxCell><mxCell id="n50" value="4 · Service layer" style="shape=step;perimeter=stepPerimeter;size=10;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="250" height="24" as="geometry" /></mxCell><mxCell id="n51" value="&lt;b&gt;Redis Streams&lt;/b&gt;&lt;br&gt;event bus&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;consumer group&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;+ dead-letter&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="752" width="150" height="95" as="geometry" /></mxCell><mxCell id="n52" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Dũng · scale ngang&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in-app: inbox, WebSocket&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;out-app: push, email&lt;/font&gt;" style="rounded=1;arcSize=5;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=11;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="200" y="752" width="470" height="95" as="geometry" /></mxCell><mxCell id="n53" value
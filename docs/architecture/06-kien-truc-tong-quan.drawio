ometry x="502" y="89" width="420" height="60" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;Trang quản trị&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;Next.js · kiểm duyệt, xu hướng, tra cứu đơn, số liệu, lịch trống và giá&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="962" y="89" width="420" height="60" as="geometry" /></mxCell><mxCell id="c36" value="&lt;b&gt;API Gateway (Traefik)&lt;/b&gt; &lt;span style='font-size:9px;color:#666666'&gt;· kiểm tra token đăng nhập · giới hạn số request · không nhận file video&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="37" y="212" width="1360" height="56" as="geometry" /></mxCell><mxCell id="c37" value="&lt;b&gt;CloudFront CDN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;phát video và ảnh&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;lưu đệm gần người dùng&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1447" y="212" width="210" height="70" as="geometry" /></mxCell><mxCell id="c38" value="&lt;b&gt;inventory&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;sửa lịch trống, giá&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="57" y="427" width="116" height="47" as="geometry" /></mxCell><mxCell id="c39" value="&lt;b&gt;booking&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;giữ chỗ, đơn&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="57" y="375" width="116" height="47" as="geometry" /></mxCell><mxCell id="c40" value="&lt;b&gt;payment&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;thanh toán giả lập&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="182" y="375" width="116" height="47" as="geometry" /></mxCell><mxCell id="c42" value="giữ chỗ 30 phút · đặt chỗ là một giao dịch" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=8;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="47" y="490" width="260" height="16" as="geometry" /></mxCell><mxCell id="c43" value="&lt;b&gt;social&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;bài đăng, tương tác&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="327" y="375" width="146" height="47" as="geometry" /></mxCell><mxCell id="c44" value="&lt;b&gt;media&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;tải ảnh, video&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="482" y="375" width="146" height="47" as="geometry" /></mxCell><mxCell id="c45" value="&lt;b&gt;feed&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;bảng tin, điểm xu hướng&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="327" y="427" width="146" height="47" as="geometry" /></mxCell><mxCell id="c46" value="&lt;b&gt;moderation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;kiểm duyệt&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="482" y="427" width="146" height="47" as="geometry" /></mxCell><mxCell id="c47" value="ẩn bài và báo sự kiện cùng lúc" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=8;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="317" y="490" width="320" height="16" as="geometry" /></mxCell><mxCell id="c48" value="&lt;b&gt;auth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;đăng nhập, phiên của khách&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="657" y="375" width="170" height="47" as="geometry" /></mxCell><mxCell id="c50" value="3 vai trò: người dùng, kiểm duyệt viên, quản trị" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=8;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="647" y="490" width="190" height="16" as="geometry" /></mxCell><mxCell id="c51" value="&lt;b&gt;search&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;đặt chỗ + mạng xã hội&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="857" y="375" width="200" height="47" as="geometry" /></mxCell><mxCell id="c52" value="&lt;b&gt;recommend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;gợi ý theo gu&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="857" y="427" width="200" height="47" as="geometry" /></mxCell><mxCell id="c53" value="lọc bài ẩn, lọc ngân sách" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=8;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="847" y="490" width="220" height="16" as="geometry" /></mxCell><mxCell id="c54" value="&lt;b&gt;analytics&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;sự kiện, số liệu,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;theo dõi xu hướng, đẩy ảo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="857" y="541" width="200" height="52" as="geometry" /></mxCell><mxCell id="c55" value="Không đọc bảng của module khác, không giao dịch chéo module · module gọi nhau qua hàm công khai, báo nhau qua sự kiện&lt;br&gt;Search: luồng đặt chỗ hiểu câu bằng luật; luồng mạng xã hội hiểu câu bằng AI (chưa chốt); kết quả luôn lấy từ Postgres&lt;br&gt;&lt;b&gt;Back office:&lt;/b&gt; chỉ tài khoản nhân viên · kiểm duyệt viên không xem thông tin thanh toán · mọi thao tác kiểm duyệt ghi lại ai làm, lúc nào, vì sao" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=9;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="47" y="530" width="790" height="64" as="geometry" /></mxCell><mxCell id="c56" value="&lt;b&gt;ai-service&lt;/b&gt; · Python · FastAPI&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;không lưu dữ liệu nghiệp vụ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0f0ee;strokeColor=#12aab5;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1167" y="327" width="230" height="110" as="geometry" /></mxCell><mxCell id="c57" value="&lt;b&gt;Nhà cung cấp AI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;trò chuyện, kiểm duyệt, embedding&lt;/span&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1467" y="348" width="135" height="90" as="geometry" /></mxCell><mxCell id="c58" value="&lt;b&gt;Redis Streams: hàng đợi sự kiện&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;chuyển sự kiện giữa các module và service · mỗi nơi nhận có hàng đợi riêng · sự kiện lỗi được giữ lại để xử lý sau&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="557" y="632" width="750" height="42" as="geometry" /></mxCell><mxCell id="c59" value="&lt;b&gt;video-worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;Node · FFmpeg&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;chuyển video sang nhiều mức chất lượng&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;tạo ảnh bìa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="597" y="699" width="230" height="90" as="geometry" /></mxCell><mxCell id="c60" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;NestJS&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;thông báo trong app&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;thông báo đẩy, email&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="997" y="699" width="230" height="90" as="geometry" /></mxCell><mxCell id="c61" value="&lt;b&gt;Dịch vụ gửi thông báo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;thông báo đẩy, email (Amazon SES)&lt;/span&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1437" y="770" width="215" height="80" as="geometry" /></mxCell><mxCell id="c62" value="&lt;b&gt;Postgres core&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;5 schema: access, content, discovery, analytics, commerce&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;mỗi module một tài khoản riêng&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;dữ liệu sản phẩm giả lập, nạp lại được&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="27" y="868" width="395" height="115" as="geometry" /></mxCell><mxCell id="c63" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;hàng đợi sự kiện&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;hàng đợi việc nền&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="432" y="868" width="100" height="115" as="geometry" /></mxCell><mxCell id="c64" value="&lt;b&gt;S3 (Sydney)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;video gốc, video đã chuyển đổi,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;ảnh bìa&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="607" y="868" width="212" height="115" as="geometry" /></mxCell><mxCell id="c65" value="&lt;b&gt;Postgres notification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;hộp thư, lịch sử gửi,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#666666'&gt;tuỳ chọn thông báo&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1007" y="868" width="210" height="115" as="geometry" /></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.4750;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6212;entryY=0.0000;entryDx=0;entryDy=0;strokeColor=#2f6fcb;" edge="1" parent="1" source="c36" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c69" value="/api" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#333333;spacing=0;" vertex="1" parent="1"><mxGeometry x="690" y="272" width="40" height="14" as="geometry" /></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.9162;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5043;entryY=0.0000;entryDx=0;entryDy=0;strokeColor=#
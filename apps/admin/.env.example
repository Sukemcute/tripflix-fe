# Địa chỉ gateway (Traefik trong deploy/compose.yaml của tripflix-be).
NEXT_PUBLIC_API_URL=http://localhost:8080
# UI preview login is enabled in development only. Explicitly opt in for a local production-build review.
ADMIN_ENABLE_DEMO_LOGIN=false
# Địa chỉ web người dùng, dùng cho liên kết "Xem trên web" ở màn Kiểm duyệt (mặc định http://localhost:3100).
NEXT_PUBLIC_WEB_URL=http://localhost:3100

# Địa chỉ gateway (Traefik trong deploy/compose.yaml của tripflix-be).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Đăng nhập Google: OAuth Client ID loại Web (Google Cloud Console). Trống thì không hiện nút Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Trang quản trị (apps/admin). Nhân viên thấy nút "Mở trang quản trị" ở /account; để trống thì ẩn.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200

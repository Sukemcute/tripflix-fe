# Địa chỉ gateway (Traefik trong deploy/compose.yaml của tripflix-be).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Trợ lý Tripi (tripflix-ai). Trống thì dùng <NEXT_PUBLIC_API_URL>/ai như gateway; chạy AI riêng ở máy thì đặt http://localhost:8000.
NEXT_PUBLIC_AI_URL=
# Đăng nhập Google: OAuth Client ID loại Web (Google Cloud Console). Trống thì không hiện nút Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Trang quản trị (apps/admin). Nhân viên thấy nút "Mở trang quản trị" ở /account; để trống thì ẩn.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200
# Địa chỉ công khai của web, dùng cho canonical, ảnh chia sẻ, sitemap và robots (TF112). Nhúng lúc build.
NEXT_PUBLIC_SITE_URL=https://tripflix.io.vn
# Gateway mà server Next gọi khi dựng metadata và sitemap. Trống thì dùng NEXT_PUBLIC_API_URL;
# trong Docker có thể đặt địa chỉ nội bộ, ví dụ http://gateway:8080.
API_INTERNAL_URL=

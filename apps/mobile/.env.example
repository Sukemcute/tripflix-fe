# Địa chỉ gateway (docs/11 §7.5):
#   Android emulator:           http://10.0.2.2:8080
#   Điện thoại thật cùng wifi:  http://<IP LAN của máy>:8080  (mở cổng 8080 trong Windows Firewall, mạng Private)
#   Expo web trên máy tính:    http://localhost:8080 (thêm origin của Expo web vào AUTH_WEB_ORIGINS ở BE)
# Khởi động lại Expo sau khi đổi biến môi trường; không dùng địa chỉ emulator cho trình duyệt trên máy tính.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

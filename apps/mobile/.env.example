# Địa chỉ gateway (docs/11 §7.5):
#   Android emulator:           http://10.0.2.2:8080
#   Điện thoại thật cùng wifi:  http://<IP LAN của máy>:8080  (mở cổng 8080 trong Windows Firewall, mạng Private)
#   Expo web trên máy tính:    http://localhost:8080 (thêm origin của Expo web vào AUTH_WEB_ORIGINS ở BE)
# Khởi động lại Expo sau khi đổi biến môi trường; không dùng địa chỉ emulator cho trình duyệt trên máy tính.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# TF08: link HLS và ảnh bìa Phong cấp để thử trình phát trong development, trước khi có playback API.
# Bỏ trống thì tab Reels hiện trạng thái chờ video. Không bật nguồn thử này trong production.
EXPO_PUBLIC_REELS_DEMO_HLS_URL=
# Bỏ trống ảnh bìa để dùng poster_360/540/720.jpg cạnh master HLS của worker Tripflix.
EXPO_PUBLIC_REELS_DEMO_POSTER_URL=
# Địa chỉ web Tripflix, để mở Điều khoản sử dụng và Chính sách bảo mật từ màn đăng ký (TF06O). Ví dụ https://tripflix.io.vn
EXPO_PUBLIC_WEB_URL=
